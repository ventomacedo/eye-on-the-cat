USERNAME = '' # Usuário da câmera IP
PASSWORD = '' # Senha da câmera IP
PORT = 000 # Porta do RTSP

DEVICE_TYPE = 'cpu' # Tipo de dispositivo para processamento: "cpu", "cuda" ou "mps"
SHOW_WINDOW = False # Se carrega a janela de visualização ou não
TAKE_PICTURE = True # Se tira foto quando detecta movimento ou não
TAKE_RECORD = True # Se grava vídeo quando detecta movimento ou não

CAMERAS = '[]' # Câmeras a serem monitoradas - [ { "name": "Garagem", "ip": "192.168.0.10" } ]

TUYA_DEVICE_ID = '' # ID do dispositivo Tuya (Neo Avant)
TUYA_DEVICE_KEY = '' # Chave local do dispositivo Tuya
TUYA_DEVICE_IP = '' # IP local do dispositivo Tuya
TUYA_DEVICE_TYPE = 'outlet' # Tipo do dispositivo Tuya: outlet ou bulb
TUYA_LIGHT_DPS = 1 # DPS usado para ligar/desligar a lâmpada (geralmente 1)
TUYA_DEVICE_VERSION = 3.3 # Versão do protocolo Tuya local